# ==============================================================================
# Green Route Planner - Environment Configuration Template
# Copy this file to .env or set environment variables in your deployment environment
# ==============================================================================

# Database Configuration (PostgreSQL)
# When unset, Spring Boot will automatically fall back to embedded in-memory H2 database with demo data
DB_URL=jdbc:postgresql://localhost:5432/greenroutedb
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_DRIVER=org.postgresql.Driver
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Server Port
PORT=8080

# OpenWeather API (Optional: realistic fallback meteorological simulation activates when empty)
# Obtain a free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# CORS Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
